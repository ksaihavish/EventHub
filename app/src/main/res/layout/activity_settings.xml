<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <TextView
        style="@style/SettingsHeader"
        android:text="Settings"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="12dp"/>

    <LinearLayout android:id="@+id/layoutAppearance" style="@style/SettingsItem">
        <ImageView style="@style/SettingsIcon" android:src="@android:drawable/ic_menu_manage"/>
        <TextView style="@style/SettingsText" android:text="Appearance"/>
        <TextView style="@style/SettingsChevron"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginStart="56dp" android:layout_marginEnd="16dp"/>

    <LinearLayout android:id="@+id/layoutPrivacy" style="@style/SettingsItem">
        <ImageView style="@style/SettingsIcon" android:src="@android:drawable/ic_lock_lock"/>
        <TextView style="@style/SettingsText" android:text="Privacy &amp; Security"/>
        <TextView style="@style/SettingsChevron"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginStart="56dp" android:layout_marginEnd="16dp"/>

    <LinearLayout android:id="@+id/layoutFeedback" style="@style/SettingsItem">
        <ImageView style="@style/SettingsIcon" android:src="@android:drawable/ic_menu_send"/>
        <TextView style="@style/SettingsText" android:text="Send Feedback"/>
        <TextView style="@style/SettingsChevron"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginStart="56dp" android:layout_marginEnd="16dp"/>

    <LinearLayout android:id="@+id/layoutRate" style="@style/SettingsItem">
        <ImageView style="@style/SettingsIcon" android:src="@android:drawable/btn_star_big_on"/>
        <TextView style="@style/SettingsText" android:text="Rate Our App"/>
        <TextView style="@style/SettingsChevron"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginStart="56dp" android:layout_marginEnd="16dp"/>

    <LinearLayout android:id="@+id/layoutAbout" style="@style/SettingsItem">
        <ImageView style="@style/SettingsIcon" android:src="@android:drawable/ic_menu_info_details"/>
        <TextView style="@style/SettingsText" android:text="About EventHub"/>
        <TextView style="@style/SettingsChevron"/>
    </LinearLayout>

</LinearLayout>
